          "source": "sample_company_rules.md",
          "locator": "section:远程办公"
        },
        {
          "claim_id": "wiki-remote-approval",
          "text": "远程办公须至少提前一个工作日获得直属主管批准。",
          "source": "sample_company_rules.md",
          "locator": "section:远程办公"
        },
        {
          "claim_id": "wiki-remote-excluded",
          "text": "涉及客户现场支持、机房值守的岗位不适用远程办公政策。",
          "source": "sample_company_rules.md",
          "locator": "section:远程办公"
        }
      ]
    },
    {
      "page_id": "wiki-information-security",
      "title": "信息安全",
      "summary": "内部资料的外发范围受限，敏感文件对外发送前需要审批并加密。",
      "aliases": ["数据安全", "公共网盘", "保密", "外发"],
      "version": "1.0",
      "claims": [
        {
          "claim_id": "wiki-security-upload",
          "text": "内部资料不得上传至未经公司批准的公共网盘或外部人工智能服务。",
          "source": "sample_company_rules.md",
          "locator": "section:信息安全"
        },
        {
          "claim_id": "wiki-security-external-send",
          "text": "敏感文件对外发送前须获得部门负责人批准，并使用公司指定的加密工具。",
          "source": "sample_company_rules.md",
          "locator": "section:信息安全"
        }
      ]
    },
    {
      "page_id": "wiki-account-access",
      "title": "账号与权限",
      "summary": "系统账号不得共享，权限随岗位调整变更，高权限账号需要定期复核。",
      "aliases": ["账号", "权限", "密码"],
      "version": "1.0",
      "claims": [
        {
          "claim_id": "wiki-account-sharing",
          "text": "系统账号仅限本人使用，不得共享密码或验证码。",
          "source": "sample_company_rules.md",
          "locator": "section:账号与权限"
        },
        {
          "claim_id": "wiki-account-review",
          "text": "高权限账号每 90 天复核一次。",
          "source": "sample_company_rules.md",
          "locator": "section:账号与权限"
        },
        {
          "claim_id": "wiki-account-incident",
          "text": "发现账号异常应立即联系信息安全团队。",
          "source": "sample_company_rules.md",
          "locator": "section:账号与权限"
        }
      ]
    }
  ]
